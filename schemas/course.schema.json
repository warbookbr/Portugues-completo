{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warbookbr.github.io/Portugues-completo/schemas/course.schema.json",
  "title": "Português Completo — Course Catalog v2",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "levels", "units"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^N[0-9]+$"},
          "order": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "levelId", "order", "title", "manifest"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^N[0-9]+-U[0-9]{2}$"},
          "levelId": {"type": "string", "pattern": "^N[0-9]+$"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "manifest": {"type": "string", "pattern": "^units/.+/unit\\.json$"}
        }
      }
    }
  }
}
