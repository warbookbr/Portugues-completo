{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warbookbr.github.io/Portugues-completo/schemas/unit.schema.json",
  "title": "Português Completo — Unit Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "levelId", "order", "title", "objective", "competencies", "prerequisites", "lessons", "publication"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^N[0-9]+-U[0-9]{2}$"},
    "levelId": {"type": "string", "pattern": "^N[0-9]+$"},
    "order": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^N[0-9]+-U[0-9]{2}-C[0-9]{2}$"},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^N[0-9]+-U[0-9]{2}-L[0-9]{2}$"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^lessons/.+\\.json$"}
        }
      }
    },
    "verification": {
      "type": ["object", "null"],
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^N[0-9]+-U[0-9]{2}-V[0-9]{2}$"},
        "path": {"type": "string", "pattern": "^.+\\.json$"}
      }
    },
    "publication": {
      "type": "object",
      "required": ["status", "blockers"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["DRAFT", "READY", "BLOCKED", "PUBLISHED"]},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
