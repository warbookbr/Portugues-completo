    "N0-U01-L07"
  ],
  "designPrinciples": [
    "usar exemplos novos ou recombinados quando isso reduzir acerto por memória",
    "não depender de recitação do alfabeto",
    "permitir repetição de estímulos auditivos sem penalidade",
    "ocultar a escrita quando ela entregaria uma resposta auditiva",
    "não exigir leitura autônoma de palavras",
    "não usar tempo de resposta como critério",
    "não avaliar ainda a síntese fala versus escrita nem variações letra-som movidas para a Unidade 2"
  ],
  "limits": [
    "não avaliar sílabas",
    "não avaliar formação ou leitura sistemática de palavras",
    "não exigir regras de uso de maiúsculas",
    "não exigir ortografia",
    "não exigir terminologia fonética",
    "não exigir memorização perfeita da ordem alfabética",
    "não exigir compreender ainda que uma mesma letra pode representar sons diferentes"
  ],
