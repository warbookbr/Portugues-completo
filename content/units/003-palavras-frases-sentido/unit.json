  "order": 3,
  "title": "Palavras, frases e sentido",
  "objective": "Compreender palavras pelo significado e pelo contexto e perceber como escolha, forma, organização e relações entre palavras constroem mensagens em frases simples, permitindo compreender, modificar, reconstruir e começar a produzir frases próprias.",
  "competencies": [
    {
      "id": "N0-U03-C01",
      "label": "relacionar palavras simples ao que representam ou fazem em contexto"
    },
    {
      "id": "N0-U03-C02",
      "label": "perceber proximidade e oposição simples de sentido sem depender de terminologia técnica"
    },
    {
      "id": "N0-U03-C03",
      "label": "usar contexto forte para interpretar uma palavra com mais de um significado possível"
    },
    {
      "id": "N0-U03-C04",
      "label": "reconhecer frase ou expressão como mensagem em situação, inclusive mensagem de uma palavra"
    },
    {
      "id": "N0-U03-C05",
      "label": "organizar palavras fornecidas para comunicar uma relação simples"
    },
    {
      "id": "N0-U03-C06",
      "label": "perceber o efeito de substituição, acréscimo, retirada ou modificação de palavras na mensagem"
    },
    {
      "id": "N0-U03-C07",
      "label": "compreender o efeito básico da negação sem concluir automaticamente o contrário"
    },
    {
      "id": "N0-U03-C08",
      "label": "reconhecer funcionalmente mensagens que informam, perguntam, pedem, ordenam ou expressam reação"
    },
    {
      "id": "N0-U03-C09",
      "label": "completar e reconstruir frases usando pistas de sentido e organização"
    },
    {
      "id": "N0-U03-C10",
      "label": "produzir e autorrevisar uma mensagem curta com palavras próprias"
    }
  ],
