  "order": 7,
  "title": "Ler e escrever palavras: letras e sons",
  "objective": "Ler e escrever palavras novas juntando o som de cada letra com as vogais, sílaba por sílaba.",
  "competencies": [
    {
      "id": "N0-U07-C01",
      "label": "reconhecer o som das vogais em palavras ouvidas, incluindo pelo uso E e O abertos e fechados"
    },
    {
      "id": "N0-U07-C02",
      "label": "ligar som e letra pela sílaba de consoante e vogal com M, L, S, F, V, N, P, T, B, D, C, G, J, Z, X e R nas posições ensinadas"
    },
    {
      "id": "N0-U07-C03",
      "label": "ler sílabas e palavras inéditas formadas por sílabas de consoante e vogal com as letras ensinadas"
    },
    {
      "id": "N0-U07-C04",
      "label": "escrever com fichas palavras ouvidas formadas por sílabas de consoante e vogal"
    },
    {
      "id": "N0-U07-C05",
      "label": "ler frases curtas formadas só com palavras de letras e sílabas ensinadas"
    },
    {
      "id": "N0-U07-C06",
      "label": "reconhecer que o H no começo da palavra não tem som e lembrar palavras frequentes escritas com H"
    },
    {
      "id": "N0-U07-C07",
      "label": "distinguir na escuta e na escrita as letras parecidas P e B, T e D"
    }
  ],
